{
  "name": "s-public",
  "version": "2.3.1",
  "type": "module",
  "description": "Portfolio and blog pages of s-hirano-ist.",
  "author": "s-hirano-ist",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "astro": "astro",
    "check": "astro check",
    "dev": "doppler run -- astro dev",
    "build": "doppler run -- astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "tsc": "tsc --noEmit",
    "fmt": "prettier --check **/*.astro .",
    "fmt:fix": "prettier --write **/*.astro .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "lint:mark": "markdownlint-cli2 **/*.md",
    "lint:mark:fix": "markdownlint-cli2-fix **/*.md",
    "license:summary": "license-checker-rseidelsohn --summary > license.summary.txt",
    "license:json": "license-checker-rseidelsohn --json > src/data/license/data.gen.json",
    "security": "pnpm audit",
    "generate:photo": "tsx script/generate-photo-path.ts",
    "generate:book": "doppler run -- tsx script/generate-book-data.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/react": "6.0.2",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/noto-sans-jp": "5.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@s-hirano-ist/s-ui": "1.19.13",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.0",
    "lenis": "1.3.26",
    "photoswipe": "5.4.4",
    "rehype-autolink-headings": "7.1.0",
    "sanitize-html": "2.17.6",
    "satori": "0.29.0",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "tailwindcss-animated": "2.1.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@tailwindcss/typography": "0.5.20",
    "@types/react": "19.2.18",
    "@types/sanitize-html": "2.16.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.1.0",
    "license-checker-rseidelsohn": "5.0.1",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.11",
    "typescript-eslint": "8.66.0",
    "vnu-jar": "26.8.6",
    "yaml": "2.9.0"
  }
}
