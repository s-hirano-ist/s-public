{
  "name": "s-public",
  "version": "2.3.1",
  "type": "module",
  "description": "Portfolio and blog pages of s-hirano-ist.",
  "author": "s-hirano-ist",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "astro": "astro",
    "check": "astro check",
    "dev": "doppler run -- astro dev",
    "build": "doppler run -- astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "tsc": "tsc --noEmit",
    "fmt": "biome format .",
    "fmt:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:mark": "markdownlint-cli2 **/*.md",
    "lint:mark:fix": "markdownlint-cli2-fix **/*.md",
    "license:summary": "license-checker-rseidelsohn --summary > license.summary.txt",
    "license:json": "license-checker-rseidelsohn --json > src/data/license/data.gen.json",
    "security": "bun audit",
    "generate:photo": "bun script/generate-photo-path.ts",
    "generate:book": "doppler run -- bun script/generate-book-data.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.0",
    "lenis": "1.3.26",
    "photoswipe": "5.4.4",
    "satori": "0.29.0",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.8",
    "@tailwindcss/typography": "0.5.20",
    "@types/react": "19.2.18",
    "license-checker-rseidelsohn": "5.0.1",
    "markdownlint-cli2": "0.23.2",
    "react": "19.2.8",
    "vnu-jar": "26.8.6",
    "yaml": "2.9.0"
  },
  "overrides": {
    "diff": ">=8.0.3",
    "next": ">=16.3.0",
    "postcss": ">=8.5.26",
    "yaml": "2.9.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver",
    "vnu-jar"
  ]
}
