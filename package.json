{
  "name": "s-public",
  "version": "2.3.1",
  "type": "module",
  "description": "Portfolio and blog pages of s-hirano-ist.",
  "author": "s-hirano-ist",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "astro": "astro",
    "check": "astro check",
    "dev": "doppler run -- astro dev",
    "build": "doppler run -- astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "fmt": "biome format .",
    "fmt:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "security": "bun audit",
    "generate:photo": "bun script/generate-photo-path.ts",
    "generate:book": "doppler run -- bun script/generate-book-data.ts"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@astrojs/sitemap": "3.7.3",
    "@s-hirano-ist/s-ui": "2.0.3",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.4",
    "lenis": "1.3.26",
    "satori": "0.29.0",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.10",
    "@tailwindcss/typography": "0.5.20",
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0"
  },
  "overrides": {},
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
