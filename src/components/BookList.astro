---
import { MAX_RATING } from "@config";
import books from "@data/book/data.gen.json";

const tags = [...new Set(books.flatMap(book => book.tags))];
const ratingSteps = Array.from(
  { length: MAX_RATING + 1 },
  (_, rating) => rating,
);

for (const book of books) {
  if (
    !Number.isInteger(book.rating) ||
    book.rating < 1 ||
    MAX_RATING < book.rating
  ) {
    throw new Error(
      `Rating for ${book.title} must be an integer between 1 and ${MAX_RATING}`,
    );
  }
}
---

<book-list>
  <section class="mt-4 flex flex-col" aria-label="書籍の絞り込み">
    <div class="my-4 flex">
      <div class="shrink-0">
        <p class="text-sm text-muted-foreground">該当冊数</p>
        <output
          data-book-count
          class="block pt-2 text-2xl font-semibold"
          aria-live="polite"
          >{books.length}冊</output
        >
      </div>
      <div class="h-48 overflow-y-scroll p-4">
        {tags.map(tag => (
            <button
              type="button"
              data-book-tag
              data-tag={tag}
              aria-pressed="false"
              class="m-1 h-6 rounded-md border border-border px-2 text-xs hover:bg-muted aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground">
              #{tag}
            </button>
          ))}
      </div>
    </div>
    <label for="book-rating" class="mb-2 text-sm text-muted-foreground">
      最低評価
    </label>
    <input
      id="book-rating"
      data-book-rating
      type="range"
      min="0"
      max={MAX_RATING}
      value="0"
      step="1"
      class="w-full accent-primary">
    <div class="flex w-full justify-between px-2 text-xs" aria-hidden="true">
      {ratingSteps.map(rating => (
          <span>{rating === 0 ? "すべて" : rating}</span>
        ))}
    </div>
  </section>

  <div class="grid gap-8 pt-8 sm:grid-cols-2 lg:grid-cols-3">
    {books.map(book => (
        <a
          data-book-card
          data-rating={book.rating}
          data-tags={JSON.stringify(book.tags)}
          href={book.googleHref}
          target="_blank"
          class="block overflow-hidden rounded-lg border border-border bg-card text-card-foreground shadow-xl"
          rel="noopener">
          <figure class="flex h-48 items-center justify-center overflow-hidden">
            <img
              src={book.googleImgSrc}
              alt={book.title}
              decoding="async"
              loading="lazy"
              class="h-full w-auto max-w-full object-contain"
            />
          </figure>
          <div class="max-w-96 p-4">
            <h2 class="text-lg font-semibold">{book.title}</h2>
            <p class="h-12 grow-0 text-sm text-muted-foreground">
              {book.googleSubtitle}
            </p>
            <span class="inline-flex rounded-md bg-muted px-2 py-1 text-xs">
              {book.googleAuthors.toString()}
            </span>
            <p class="overflow-y-hidden text-xs text-muted-foreground">
              {book.googleDescription}
            </p>
            <div
              role="img"
              class="mt-2 text-lg text-primary"
              aria-label={`${MAX_RATING}段階中${book.rating}の評価`}>
              <span aria-hidden="true">
                {ratingSteps.slice(1).map(rating =>
                  rating <= book.rating ? "★" : "☆",
                )}
              </span>
            </div>
            <div class="flex justify-end gap-1 p-0 pt-2">
              {book.tags.map(tag => (
                  <span class="inline-flex rounded-md border border-border px-2 py-1 text-xs">
                    #{tag}
                  </span>
                ))}
            </div>
          </div>
        </a>
      ))}
  </div>
</book-list>

<script>
class BookList extends HTMLElement {
  connectedCallback() {
    if (this.dataset.initialized === "true") return;
    this.dataset.initialized = "true";

    const count = this.querySelector<HTMLOutputElement>("[data-book-count]");
    const ratingInput =
      this.querySelector<HTMLInputElement>("[data-book-rating]");
    const tagButtons = [
      ...this.querySelectorAll<HTMLButtonElement>("[data-book-tag]"),
    ];
    const cards = [...this.querySelectorAll<HTMLElement>("[data-book-card]")];

    if (!count || !ratingInput) return;

    const availableTags = new Set(
      tagButtons.map(button => button.dataset.tag).filter(Boolean),
    );
    const requestedTag = new URLSearchParams(window.location.search).get("tag");
    let selectedTag =
      requestedTag && availableTags.has(requestedTag)
        ? requestedTag
        : undefined;

    const applyFilters = () => {
      const minimumRating = Number(ratingInput.value);
      let visibleBooks = 0;

      for (const card of cards) {
        const rating = Number(card.dataset.rating);
        const tags = JSON.parse(card.dataset.tags ?? "[]") as string[];
        const visible =
          rating >= minimumRating &&
          (selectedTag === undefined || tags.includes(selectedTag));
        card.hidden = !visible;
        if (visible) visibleBooks += 1;
      }

      count.value = `${visibleBooks}冊`;
      count.textContent = `${visibleBooks}冊`;
      for (const button of tagButtons) {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.tag === selectedTag),
        );
      }
    };

    ratingInput.addEventListener("input", applyFilters);
    for (const button of tagButtons) {
      button.addEventListener("click", () => {
        const tag = button.dataset.tag;
        selectedTag = selectedTag === tag ? undefined : tag;

        const url = new URL(window.location.href);
        if (selectedTag) url.searchParams.set("tag", selectedTag);
        else url.searchParams.delete("tag");
        history.replaceState(history.state, "", url);

        applyFilters();
      });
    }

    applyFilters();
  }
}

if (!customElements.get("book-list")) {
  customElements.define("book-list", BookList);
}
</script>
