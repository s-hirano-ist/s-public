---
import { Image } from "astro:assets";
import Lightbox from "@components/Lightbox.astro";
import { SITE } from "@config";
import { CONTENTS } from "@data/_photo/data";
import PortfolioLayout from "@layouts/PortfolioLayout.astro";
import { buildBreadcrumbList } from "@utils/jsonLd";

const baseUrl = SITE.website.replace(/\/$/, "");

const jsonLd = [
  buildBreadcrumbList([{ name: "Photo", url: `${baseUrl}/photo` }]),
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "sola-apochromat-lens",
    description:
      "撮影の議事録 from 2020年。風景写真から日常のスナップまで、レンズを通して見た世界を記録しています。",
    url: `${baseUrl}/photo`,
    isPartOf: { "@id": `${baseUrl}/#website` },
  },
];
---

<PortfolioLayout
  headerTitle="PHOTOGRAPH"
  title="sola-apochromat-lens"
  subTitle="撮影の議事録 from 2020年。風景写真から日常のスナップまで、レンズを通して見た世界を記録しています。"
  jsonLd={jsonLd}>
  <div class="grid w-full grid-cols-3 gap-4" data-lightbox-gallery>
    {CONTENTS.map(src => {
        return (
          <a
            href={src.src}
            target="_blank"
            rel="noopener"
            class="group overflow-hidden rounded-lg shadow-sm transition-shadow duration-300 hover:shadow-md">
            <div class="aspect-square overflow-hidden">
              <Image
                class="aspect-square object-contain transition-transform duration-300 group-hover:scale-[1.02]"
                src={src}
                alt=""
              />
            </div>
          </a>
        );
      })}
  </div>
  <Lightbox />
</PortfolioLayout>
