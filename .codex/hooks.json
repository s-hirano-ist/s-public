{
  "description": "Require a clean formatting check before a Codex turn stops.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel)\" && bun \"$repo_root/script/stop-format-hook.mjs\"",
            "timeout": 120,
            "statusMessage": "Checking workspace formatting"
          }
        ]
      }
    ]
  }
}
